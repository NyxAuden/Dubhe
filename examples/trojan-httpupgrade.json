{
  "version": 1,
  "inbounds": [
    {
      "type": "trojan-httpupgrade",
      "tag": "trojan-httpupgrade-in",
      "listen": "127.0.0.1:10445",
      "users": [
        {
          "name": "trojan-httpupgrade-user",
          "password": "REPLACE_WITH_A_RANDOM_TROJAN_HTTPUPGRADE_PASSWORD"
        }
      ],
      "allow_insecure_transport": true,
      "httpupgrade": {
        "path": "/proxy"
      }
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "reject",
      "tag": "reject"
    }
  ],
  "route": {
    "default": "direct",
    "rules": []
  }
}
