{
  "version": 1,
  "inbounds": [
    {
      "type": "vless-ws",
      "tag": "vless-wss-in",
      "listen": "127.0.0.1:10441",
      "users": [
        { "name": "vless-wss-user", "uuid": "REPLACE_WITH_A_RANDOM_VLESS_WSS_UUID_BEFORE_USE" }
      ],
      "xudp": false,
      "certificate": "/absolute/path/to/vless-wss/fullchain.pem",
      "private_key": "/absolute/path/to/vless-wss/private-key.pem",
      "websocket": {
        "path": "/proxy",
        "early_data": { "mode": "header", "max_bytes": 2048 }
      }
    }
  ],
  "outbounds": [
    { "type": "direct", "tag": "direct" },
    { "type": "reject", "tag": "reject" }
  ],
  "route": { "default": "direct", "rules": [] }
}
