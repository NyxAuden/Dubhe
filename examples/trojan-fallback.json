{
  "version": 1,
  "inbounds": [
    {
      "type": "trojan",
      "tag": "trojan-fallback",
      "listen": "127.0.0.1:8443",
      "users": [
        { "name": "example-user", "password": "REPLACE_WITH_A_RANDOM_SECRET_BEFORE_USE" }
      ],
      "fallbacks": [
        { "dest": 8080, "name": "example.com" },
        { "dest": "127.0.0.1:8441" }
      ],
      "certificate": "/absolute/path/to/fullchain.pem",
      "private_key": "/absolute/path/to/private-key.pem"
    }
  ],
  "outbounds": [
    { "type": "direct", "tag": "direct" },
    { "type": "reject", "tag": "reject" }
  ],
  "route": { "default": "direct" }
}
