{
  "version": 1,
  "inbounds": [
    {
      "type": "snell",
      "tag": "snell-obfs-in",
      "listen": "127.0.0.1:10448",
      "psk": "REPLACE_WITH_A_RANDOM_SNELL_PSK",
      "version": 5,
      "obfs_mode": "tls",
      "users": [
        { "name": "example-user", "userkey": "REPLACE_WITH_A_RANDOM_SNELL_USERKEY" }
      ]
    }
  ],
  "outbounds": [
    { "type": "direct", "tag": "direct" },
    { "type": "reject", "tag": "reject" }
  ],
  "route": { "default": "direct" }
}
