+use super::aead_budget::AeadBudget;
+
+#[cfg(test)]
+mod budget_tests {
+    use super::*;
+
+    const METHOD: CipherKind = CipherKind::AEAD2022_BLAKE3_AES_128_GCM;
+    const INITIAL_HEADER_LEN: usize = 16 + 1 + 8 + 2 + 16;
+
+    fn new_writer() -> EncryptedWriter {
+        EncryptedWriter::new(StreamType::Client, METHOD, &[0x11; 16], &[0x22; 16])
+    }
+
+    fn new_reader() -> DecryptedReader {
+        DecryptedReader::new(StreamType::Server, METHOD, &[0x11; 16])
+    }
+
+    include!("aead_budget_tests.rs");
+
+    #[test]
+    fn aead_budget_all_2022_methods_count_request_and_response_headers() {
+        for method in [
+            METHOD,
+            CipherKind::AEAD2022_BLAKE3_AES_256_GCM,
+            CipherKind::AEAD2022_BLAKE3_CHACHA20_POLY1305,
+        ] {
+            for direction in [StreamType::Client, StreamType::Server] {
+                let key = vec![0x11; method.key_len()];
+                let salt = vec![0x22; method.salt_len()];
+                let mut writer = EncryptedWriter::new(direction, method, &key, &salt);
+                if direction == StreamType::Server {
+                    writer.set_request_salt(Bytes::from(vec![0x33; method.salt_len()]));
+                }
+                writer.budget = AeadBudget::with_remaining(2);
+                let mut io = ControlledIo::new(&[], true);
+                assert_eq!(finish_write(&mut writer, &mut io, b"final").unwrap(), 5);
+                assert_eq!(writer.budget.remaining(), 0);
+                assert!(finish_write(&mut writer, &mut io, b"blocked").is_err());
+                let peer_direction = if direction == StreamType::Client {
+                    StreamType::Server
+                } else {
+                    StreamType::Client
+                };
+                let mut reader = DecryptedReader::new(peer_direction, method, &key);
+                reader.budget = AeadBudget::with_remaining(2);
+                let mut input = ControlledIo::new(&io.output, true);
+                let mut output = [0; 5];
+                assert_eq!(finish_read(&mut reader, &mut input, &mut output).unwrap(), 5);
+                assert_eq!(output, *b"final");
+                assert_eq!(reader.budget.remaining(), 0);
+                assert!(finish_read(&mut reader, &mut input, &mut output).is_err());
+            }
+        }
+    }
+
+    #[test]
+    fn aead_budget_authenticated_user_reset_does_not_revive_a_used_writer() {
+        let mut writer = new_writer();
+        writer.reset_cipher_with_key(&[0x33; 16]);
+        assert!(writer.budget.may_initialize_cipher());
+        let mut output = ControlledIo::new(&[], false);
+        let mut cx = task::Context::from_waker(std::task::Waker::noop());
+        assert!(matches!(
+            writer.poll_write_encrypted(&mut cx, &mut output, b"first"),
+            Poll::Ready(Ok(5))
+        ));
+        let sent = output.output.len();
+        writer.reset_cipher_with_key(&[0x33; 16]);
+        assert!(matches!(
+            writer.poll_write_encrypted(&mut cx, &mut output, b"again"),
+            Poll::Ready(Err(_))
+        ));
+        assert_eq!(output.output.len(), sent);
+    }
+}
